alpha = 0,
lambda = lambda_seq,
standardize = FALSE,
intercept = TRUE
)
coef_mat <- as.matrix(coef(ridge)) # extract coefficients
vars <- c("crim", "chas", "nox") # select variables we want from BostonHousing
# Create and convert data frame
df <- data.frame(
lambda = ridge$lambda,
t(coef_mat[vars, ]) # take transpose to turn variables into columns
)
df_new <- df |> # we need to make our wide data frame long
pivot_longer( # use when one variable on x-axis and multiple on y-axis
cols = all_of(vars),
names_to = "variable",
values_to = "coefficient"
)
# Plot
plot <- ggplot(df_new, aes(x = lambda, y = coefficient, color = variable)) +
geom_line() +
geom_hline(yintercept = 0, color = "black", linetype = "dashed") + # horizontal line at y=0
annotate("text", x = max(df_new$lambda) * 0.8, y = 0, label = "y = 0", hjust = 1, vjust = 1.2, size = 3.5) +
scale_color_manual(
values = c(
crim = "blue",
chas = "red",
nox  = "green"
)
) +
labs(
x = "λ",
y = "Estimated β coefficient",
color = "Variable"
) +
theme_minimal()
plot
library(kableExtra)
nodes <- data.frame(
name   = c("Z", "D", "Y", "U"),
x      = c(1,    3,   5,   3),
y      = c(0,    0,   0,  -2),
latent = c(FALSE, FALSE, FALSE, TRUE)
)
# radius of circles is ~0.3 in data units
r <- 0.3
edges <- data.frame(
x    = c(1 + r,  3 + r,  3,        3 + r * cos(atan2(2, 2))),
y    = c(0,      0,      -2 + r,   -2 + r * sin(atan2(2, 2))),
xend = c(3 - r,  5 - r,  3,        5 - r * cos(atan2(2, 2))),
yend = c(0,      0,      0 - r,    0 - r * sin(atan2(2, 2))),
dashed = c(FALSE, FALSE, TRUE, TRUE)
)
ggplot() +
# solid edges
geom_segment(
data = subset(edges, !dashed),
aes(x = x, y = y, xend = xend, yend = yend),
arrow = arrow(length = unit(7, "pt"), type = "open"),
linewidth = 0.5
) +
# dashed edges
geom_segment(
data = subset(edges, dashed),
aes(x = x, y = y, xend = xend, yend = yend),
linetype = "dashed",
arrow = arrow(length = unit(7, "pt"), type = "open"),
linewidth = 0.5
) +
# solid circles (Z, D, Y)
ggforce::geom_circle(
data = subset(nodes, !latent),
aes(x0 = x, y0 = y, r = r),
inherit.aes = FALSE,
fill = "white", color = "black", linewidth = 0.5
) +
# dashed circle (U)
ggforce::geom_circle(
data = subset(nodes, latent),
aes(x0 = x, y0 = y, r = r),
inherit.aes = FALSE,
fill = "white", color = "black",
linetype = "dashed", linewidth = 0.5
) +
# node letters
geom_text(
data = nodes,
aes(x = x, y = y, label = name),
color = "black", size = 5, fontface = "bold", family = "serif"
) +
# legend
annotate("text", x = 0.5, y = -3.1,
label = "Z = Arts, medical & environmental nonprofits",
size = 3.5, hjust = 0, family = "serif") +
annotate("text", x = 0.5, y = -3.6,
label = "D = Community nonprofits per 100,000",
size = 3.5, hjust = 0, family = "serif") +
annotate("text", x = 0.5, y = -4.1,
label = "Y = Crime rate",
size = 3.5, hjust = 0, family = "serif") +
annotate("text", x = 0.5, y = -4.6,
label = "U = Unobserved confounders",
size = 3.5, hjust = 0, family = "serif") +
coord_fixed(xlim = c(0.4, 5.6), ylim = c(-5, 0.6)) +
theme_void() +
labs(title = "DAG: Sharkey et al. (2017)") +
theme(plot.title   = element_text(size = 13, margin = margin(b = 10)),
plot.margin  = margin(20, 20, 20, 20))
