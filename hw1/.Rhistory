# Unit of analysis: city-year panel
# Outcome: one-year lead of log crime rate (log_*_r_1ld)
# Treatment: all_cml_r (cumulative community nonprofits per 100,000)
# Instrument: iv_cml_r (cumulative IV nonprofits per 100,000)
# FE: city (place_id) + year (absorbed via | place_id + year)
# Weights: popweights
# SEs: clustered by place_id
# Create string of control variables
ctrl_str <- make_rhs(controls)
library(haven) # read .dta files
library(fixest) # panel FE and IV/2SLS
library(tidyverse) # data manipulation
library(modelsummary) # regression tables
library(ggplot2) # figures & DAG
library(ggforce)
library(kableExtra)
# Controls and dummy vectors
controls <- c("popdens", "asian", "black", "hispanic", "other",
"lesshs", "college", "fborn", "male1524",
"poverty", "unemployed", "manufacturing")
# RHS formula string
make_rhs <- function(vars) paste(vars, collapse = " + ")
# Unit of analysis: city-year panel
# Outcome: one-year lead of log crime rate (log_*_r_1ld)
# Treatment: all_cml_r (cumulative community nonprofits per 100,000)
# Instrument: iv_cml_r (cumulative IV nonprofits per 100,000)
# FE: city (place_id) + year (absorbed via | place_id + year)
# Weights: popweights
# SEs: clustered by place_id
# Create string of control variables
ctrl_str <- make_rhs(controls)
# OLS with two-way FE
t3_ols_murd <- feols(
as.formula(paste("log_murd_r_1ld ~ all_cml_r +", ctrl_str, "| place_id + year")),
data = df_panel, weights = ~popweights, cluster = ~place_id
)
df_lt <- read_dta("crime-nonprofits-long-term.dta") # Table 2
df_panel <- read_dta("crime-nonprofits-panel.dta") # Tables 3 & 4, figures
# Check
cat("Long-term data:", nrow(df_lt), "cities\n")
cat("Panel data:", nrow(df_panel), "city-years,",
n_distinct(df_panel$place_id), "cities,",
n_distinct(df_panel$year), "years\n")
cat("Panel years:", min(df_panel$year), "-", max(df_panel$year), "\n")
# Controls and dummy vectors
controls <- c("popdens", "asian", "black", "hispanic", "other",
"lesshs", "college", "fborn", "male1524",
"poverty", "unemployed", "manufacturing")
# RHS formula string
make_rhs <- function(vars) paste(vars, collapse = " + ")
# Unit of analysis: city-year panel
# Outcome: one-year lead of log crime rate (log_*_r_1ld)
# Treatment: all_cml_r (cumulative community nonprofits per 100,000)
# Instrument: iv_cml_r (cumulative IV nonprofits per 100,000)
# FE: city (place_id) + year (absorbed via | place_id + year)
# Weights: popweights
# SEs: clustered by place_id
# Create string of control variables
ctrl_str <- make_rhs(controls)
# OLS with two-way FE
t3_ols_murd <- feols(
as.formula(paste("log_murd_r_1ld ~ all_cml_r +", ctrl_str, "| place_id + year")),
data = df_panel, weights = ~popweights, cluster = ~place_id
)
t3_ols_viol <- feols(
as.formula(paste("log_viol_r_1ld ~ all_cml_r +", ctrl_str, "| place_id + year")),
data = df_panel, weights = ~popweights, cluster = ~place_id
)
t3_ols_prop <- feols(
as.formula(paste("log_prop_r_1ld ~ all_cml_r +", ctrl_str, "| place_id + year")),
data = df_panel, weights = ~popweights, cluster = ~place_id
)
# 2SLS
# fixest IV syntax: y ~ exogenous | FE | endogenous ~ instrument
t3_iv_murd <- feols(
as.formula(paste("log_murd_r_1ld ~", ctrl_str, "| place_id + year | all_cml_r ~ iv_cml_r")),
data = df_panel, weights = ~popweights, cluster = ~place_id
)
t3_iv_viol <- feols(
as.formula(paste("log_viol_r_1ld ~", ctrl_str, "| place_id + year | all_cml_r ~ iv_cml_r")),
data = df_panel, weights = ~popweights, cluster = ~place_id
)
t3_iv_prop <- feols(
as.formula(paste("log_prop_r_1ld ~", ctrl_str, "| place_id + year | all_cml_r ~ iv_cml_r")),
data = df_panel, weights = ~popweights, cluster = ~place_id
)
cat("\nTable 3 IV First-Stage F:", fitstat(t3_iv_murd, "ivf")[[1]][[1]], "\n")
# Output
modelsummary(
list(
"OLS: Murder"   = t3_ols_murd,
"OLS: Violent"  = t3_ols_viol,
"OLS: Property" = t3_ols_prop,
"IV: Murder"    = t3_iv_murd,
"IV: Violent"   = t3_iv_viol,
"IV: Property"  = t3_iv_prop
),
coef_map = c(
"all_cml_r"     = "Community nonprofits per 100k",
"fit_all_cml_r" = "Community nonprofits per 100k"
),
vcov     = ~place_id,
stars    = c("*" = 0.05, "**" = 0.01, "***" = 0.001),
gof_map  = c("nobs", "adj.r.squared"),
title    = "Table 3: OLS and IV Fixed-Effects Estimates",
output   = "kableExtra"
) |>
kable_styling(font_size = 8, latex_options = "scale_down")
setwd("~/Documents/Duke/Fall 2026/Text as Data - Language Models, AI, and NLP Techniques/text-as-data/hw1")
library(readr)
library(dplyr)
library(tidyr)
library(stringr)
library(tidytext)
library(ggplot2)
library(forcats)
library(tibble)
library(scales)
knitr::opts_chunk$set(echo = FALSE)
## Read and combine text files
# Downloaded text files to folder and followed same naming conventions
file_a <- "texts/A07594__Circle_of_Commerce.txt"
file_b <- "texts/B14801__Free_Trade.txt"
# Read the raw text files into R
text_a <- read_file(file_a)
text_b <- read_file(file_b)
# Combine into a tibble for tidytext workflows
texts <- tibble(
doc_title = c("Text A", "Text B"),
text = c(text_a, text_b)
)
texts
## Create stopword list
# Start with tidytext's built-in stopword list
data("stop_words")
# Add our own project-specific stopwords (you can, and will, expand this list later)
custom_stopwords <- tibble(
word = c(
"vnto", "haue", "doo", "hath", "bee", "ye", "thee"
)
)
all_stopwords <- bind_rows(stop_words, custom_stopwords) %>%
distinct(word)
all_stopwords %>% slice(1:10)
## Count words
# Create tibble 'words' with one word token per row
words <- texts %>%
unnest_tokens(word, text) # same code as given
# All tokens
tokens_before <- words %>%
count(doc_title, name = "total_tokens") # count tokens before
# Remove stopwords
words_after <- words %>%
anti_join(all_stopwords, by = "word") # anti_join to remove stopwords
# Remaining tokens
tokens_after <- words_after %>%
count(doc_title, name = "tokens_after_stopwords") # count tokens after
# Create tibble 'corpus_diagnostics'
corpus_diagnostics <- tokens_before %>%
left_join(tokens_after, by = "doc_title") %>%
mutate(
tokens_after_stopwords = coalesce(tokens_after_stopwords, 0L), # Replace NA's with 0
tokens_removed = total_tokens - tokens_after_stopwords,
percent_removed = (tokens_removed / total_tokens) * 100
)
corpus_diagnostics
## Setup
# Frequencies before stopword removal
word_counts_before <- words %>%
count(doc_title, word, sort = TRUE) # same code as given
word_counts_before
# Frequencies after stopword removal
word_counts_after <- words_after %>%
count(doc_title, word, sort = TRUE)
word_counts_after
# Plot frequent words
plot_n_words <- 15  # changed from 20 to 15
# Select most frequent words BEFORE stopword removal
word_comparison_before <- word_counts_before %>%
pivot_wider(
names_from = doc_title,
values_from = n,
values_fill = 0
) %>%
mutate(max_n = pmax(`Text A`, `Text B`)) %>%
arrange(desc(max_n))
word_plot_before <- word_comparison_before %>%
slice_head(n = plot_n_words) %>%
pivot_longer(
cols = c(`Text A`, `Text B`),
names_to = "doc_title",
values_to = "n"
) %>%
mutate(word = fct_reorder(word, n, .fun = max))
ggplot(word_plot_before, aes(x = n, y = word)) + #black magic happens thanks to ggplot
geom_col() +
facet_wrap(~ doc_title, scales = "free_x") +
labs(
title = "Most frequent words (before stopwords removed)",
subtitle = paste0(
"Top ", plot_n_words,
" words by maximum frequency across both texts"
),
x = "Word frequency",
y = NULL
) +
theme_minimal()
# Repeat same steps for most frequent words AFTER stopword removal
word_comparison_after <- word_counts_after %>%
pivot_wider(
names_from = doc_title,
values_from = n,
values_fill = 0
) %>%
mutate(max_n = pmax(`Text A`, `Text B`)) %>%
arrange(desc(max_n))
word_plot_after <- word_comparison_after %>%
slice_head(n = plot_n_words) %>%
pivot_longer(
cols = c(`Text A`, `Text B`),
names_to = "doc_title",
values_to = "n"
) %>%
mutate(word = fct_reorder(word, n, .fun = max))
ggplot(word_plot_after, aes(x = n, y = word)) +
geom_col() +
facet_wrap(~ doc_title, scales = "free_x") +
labs(
title = "Most frequent words (after stopwords removed)",
subtitle = paste0(
"Top ", plot_n_words,
" words by maximum frequency across both texts"
),
x = "Word frequency",
y = NULL
) +
theme_minimal()
# Remove the standard tidytext stopwords (stop_words) but not the custom Early Modern stopwords (custom_stopwords)
words_no_standard_stopwords <- words %>%
anti_join(stop_words, by = "word")
words_no_standard_stopwords
# Count (no standard tidytext stopwords)
word_counts_no_standard <- words_no_standard_stopwords %>%
count(doc_title, word, sort = TRUE)
word_counts_no_standard
# Pivot table with top 15 most frequent words
top15_no_standard <- word_counts_no_standard %>%
pivot_wider(
names_from = doc_title,
values_from = n,
values_fill = 0
) %>%
mutate(max_n = pmax(`Text A`, `Text B`)) %>%
arrange(desc(max_n)) %>%
slice_head(n = 15) %>%
select(word, `Text A`, `Text B`)
top15_no_standard
